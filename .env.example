# Copy to .env and fill in real values. .env is gitignored; this file is not.

# --- OpenRouter (required by source/code/OpenRouter/* eval scripts) ---
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Hugging Face (optional) ---
# Only needed if a dataset snapshot download is rate-limited or gated.
# Bird/Spider download from public repos and normally work without it.
HF_TOKEN=

# --- Postgres (only for the Defog Postgres eval: OpenRouter/gpt_o4_mini/defog_postgress.py) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
